# API
NODE_ENV=development
PORT=3333

# Database: update credentials/host/schema for your Postgres instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms?schema=shadow"

# Auth
JWT_SECRET="0123456789abcdef0123456789abcdef"

# Optional: explicit trusted reverse-proxy IPs/CIDRs, separated by commas.
# Leave empty unless the API is reachable only through these trusted proxies.
# Example: DMS_TRUSTED_PROXY_CIDRS="10.0.1.0/24,198.51.100.0/24"
DMS_TRUSTED_PROXY_CIDRS=""
